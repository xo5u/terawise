{
  "name": "terawise",
  "version": "1.0.0",
  "description": "Terawise React frontend and FastAPI backend",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:server": "backend/.venv/Scripts/python.exe -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8000",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend"
  },
  "private": true,
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "leaflet": "^2.0.0-beta.4"
  }
}
